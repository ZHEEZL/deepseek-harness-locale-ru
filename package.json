{
  "name": "@deepseek-ai/dsh-client-locale-ru",
  "version": "0.1.0",
  "private": true,
  "description": "Russian (ru) language pack for the DeepSeek Harness web GUI",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "extract": "node tools/extract-dictionaries.mjs",
    "install:pack": "pwsh -File tools/install.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "locale",
    "i18n",
    "russian",
    "ru"
  ]
}
